<UserControl x:Class="SoundBridge.Gui.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SoundBridge.Gui.Views.Controls"
             xmlns:views="clr-namespace:SoundBridge.Gui.Views"
             mc:Ignorable="d">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24">
                <TextBlock Text="{Binding PageTitle}"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Margin="0,0,0,22" />

                <Border CornerRadius="12"
                        Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Master device"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding WindowsDefaultDeviceName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sample rate"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12" />
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0">
                                <Run Text="{Binding SampleRateDisplay, Mode=OneWay}" />
                                <Run Text=" kHz" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Windows active output indicator -->
                <!-- <Border CornerRadius="8"
                        Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        Padding="14,9"
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions> -->

                        <!-- Status dot -->
