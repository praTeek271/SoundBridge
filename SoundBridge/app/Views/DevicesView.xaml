                                 VerticalAlignment="Center"
                                 Margin="0,0,9,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoutingActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Windows active output: "
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WindowsDefaultDeviceName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border> -->

                <TextBlock Text="Audio Routing from Master Device to Multi Peripherials"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="13"
                           LineHeight="20"
                           MaxWidth="640"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,20" />

                <Border CornerRadius="18"
                        Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        Height="280"
                        Padding="16"
                        Margin="0,0,0,18">
                    <Viewbox Stretch="Uniform"
                             StretchDirection="DownOnly">
                        <views:DevicesFlowchartControl Width="800"
                                                       SourceName="{Binding MasterDeviceDisplay}"
                                                       Outputs="{Binding OverviewOutputs}"
                                                       IsConfigured="{Binding IsRoutingActive}" />
                    </Viewbox>
                </Border>

                <Border Height="1"
                        Background="{StaticResource StrokeBrush}"
                        Margin="0,0,0,14" />

                <Border CornerRadius="14"
                        Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <Border Padding="14,10"
                                Background="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonUp="RoutingConsoleHeader_MouseLeftButtonUp">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="&gt; Routing Console"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="1"
                                        MinWidth="98"
                                        CornerRadius="12"
                                        Padding="11,6"
                                        Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource InputStrokeBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="{StaticResource DangerBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRoutingActive}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="In-Active" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRoutingActive}" Value="True">
                                                            <Setter Property="Text" Value="Active" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Padding="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConsoleContentVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="{StaticResource MutedTextBrush}"
                                                 Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRoutingActive}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding RoutingStatusText}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRoutingActive}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SourceStatusText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="16,0" />
                                </Grid>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Master output"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="13"
                                               Margin="0,0,0,8" />
                                    <controls:SmoothMeterControl Height="14"
                                                                  Value="{Binding LevelPercent, Mode=OneWay}"
                                                                  IsActive="{Binding IsRoutingActive, Mode=OneWay}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding LiveOutputTiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:OutputTileControl Device="{Binding}"
                                                                        IsRoutingActive="{Binding DataContext.IsRoutingActive, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                                                                        LevelPercent="{Binding DataContext.LevelPercent, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,12">
                    <Button Content="Open Calibration"
                            Command="{Binding OpenCalibrationCommand}"
                            IsEnabled="{Binding CanOpenCalibration}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

                <TextBlock Text="{Binding ScanStatus}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
