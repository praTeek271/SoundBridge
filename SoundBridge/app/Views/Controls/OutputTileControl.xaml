<UserControl x:Class="SoundBridge.Gui.Views.Controls.OutputTileControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SoundBridge.Gui.Views.Controls">
    <Border Width="248"
            MinHeight="112"
            CornerRadius="8"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1"
            Padding="14"
            Margin="0,0,14,14">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRoutingActive, ElementName=Root}" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Device.Name, ElementName=Root, Mode=OneWay}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />

                <Ellipse Grid.Column="1"
                         Width="7"
                         Height="7"
                         Fill="{StaticResource MutedTextBrush}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRoutingActive, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>

            <controls:SmoothMeterControl Height="7"
                                          Value="{Binding LevelPercent, ElementName=Root, Mode=OneWay}"
                                          IsActive="{Binding IsRoutingActive, ElementName=Root, Mode=OneWay}"
                                          Margin="0,14,0,10">
                <controls:SmoothMeterControl.Style>
                    <Style TargetType="controls:SmoothMeterControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoutingActive, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:SmoothMeterControl.Style>
            </controls:SmoothMeterControl>

            <TextBlock FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoutingActive, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding Device.Volume, ElementName=Root, Mode=OneWay}" />
                <Run Text="% vol / " />
                <Run Text="{Binding Device.DelayMs, ElementName=Root, Mode=OneWay}" />
                <Run Text="ms" />
            </TextBlock>

            <TextBlock FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoutingActive, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="Delay " />
                <Run Text="{Binding Device.DelayMs, ElementName=Root, Mode=OneWay}" />
                <Run Text="ms" />
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
