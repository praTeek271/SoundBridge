<UserControl x:Class="SoundBridge.Gui.Views.DeviceWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Content="&#xE74D;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Width="26"
                                    Height="26"
                                    Padding="0"
                                    Margin="10,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Opacity="0.45"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip="Delete workspace"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding DeviceType, StringFormat={}{0} device workspace}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">

                        <Button
                            Content="{Binding SelectButtonText}"
                            Command="{Binding SelectCommand}"
                            IsEnabled="{Binding CanSelect}"
                            Padding="18,8"
                            MinWidth="92"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanActivate}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        <Setter Property="Foreground" Value="#FF07120B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border MaxWidth="640"
                        HorizontalAlignment="Left"
                        CornerRadius="14"
                        Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        Padding="18"
                        Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="126" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Master device:"
                                   VerticalAlignment="Center"
                                   FontSize="14" />
                        <Border Grid.Column="1"
                                CornerRadius="10"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource InputStrokeBrush}"
                                BorderThickness="1">
                            <ComboBox ItemsSource="{Binding SourceDevices}"
                                      Tag="{Binding SelectedSourceDisplayName}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedSourceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="FriendlyName"
                                      Style="{StaticResource {x:Type ComboBox}}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="ToolTip" Value="{Binding SampleRateDisplay}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                                <Setter Property="ToolTip" Value="Default device. Select another device to change." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </Border>
                        <Button Grid.Column="2"
                                Content="&#xE72C;"
                                Width="34"
                                Height="34"
                                Padding="0"
                                Margin="8,0,0,0"
                                FontFamily="Segoe MDL2 Assets"
                                Command="{Binding ScanCommand}"
                                ToolTip="Scan devices" />

                        <TextBlock Grid.Row="2"
                                   Text="Sample rate:"
                                   VerticalAlignment="Center"
                                   FontSize="14" />
                        <Border Grid.Row="2"
                                Grid.Column="1"
                                Width="156"
                                Height="36"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource InputStrokeBrush}"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SampleRateKhz, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Width="96"
                                         Height="30"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         TextAlignment="Center"
                                         Padding="0"
                                         MaxLength="7"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         TextWrapping="NoWrap" />
                                <Border Grid.Column="1"
                                        BorderBrush="{StaticResource InputStrokeBrush}"
                                        BorderThickness="1,0,0,0"
                                        Background="#11FFFFFF">
                                    <TextBlock Text="kHz"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="176" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Use"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Output device"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="Drift audio"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Border Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Background="{StaticResource StrokeBrush}" />

                    <ItemsControl Grid.Row="2"
                                  Grid.ColumnSpan="3"
                                  ItemsSource="{Binding Outputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="176" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="1" />
                                    </Grid.RowDefinitions>

                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MetadataSummary}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">
                                        <Button Content="&#xE949;"
                                                Tag="-1"
                                                Click="DelayAdjustButton_Click"
                                                DataContext="{Binding}"
                                                FontFamily="Segoe MDL2 Assets"
                                                Style="{StaticResource StepperButtonStyle}" />
                                        <TextBox Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="58"
                                                 Margin="8,0"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center" />
                                        <Button Content="&#xE948;"
                                                Tag="1"
                                                Click="DelayAdjustButton_Click"
                                                DataContext="{Binding}"
                                                FontFamily="Segoe MDL2 Assets"
                                                Style="{StaticResource StepperButtonStyle}" />
                                    </StackPanel>

                                    <Border Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Background="#1A808080" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0">

                    <Button Content="Scan"
                            Command="{Binding ScanCommand}"
                            Margin="0,0,10,0" />
                    <Button Content="Apply Configuration..."
                            Command="{Binding ApplyCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
