<UserControl x:Class="SoundBridge.Gui.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28"
              MaxWidth="560"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center"
                        Margin="0,0,0,28">
                <Image x:Name="AppIconImage"
                       Width="72"
                       Height="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14" />
                <TextBlock Text="{Binding AppName}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Version}"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Description}"
                           TextWrapping="Wrap"
                           TextAlignment="Left"
                           HorizontalAlignment="Stretch"
                           LineHeight="22"
                           FontSize="14"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,26" />

                <Border Height="1"
                        Background="{StaticResource StrokeBrush}"
                        Margin="0,0,0,22" />

                <StackPanel Margin="0,0,0,22"
                            HorizontalAlignment="Stretch">
                    <TextBlock Text="Developed by"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Left"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Developer}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextAlignment="Left"
                               HorizontalAlignment="Left"
                               Margin="0,6,0,0" />
                </StackPanel>

                <Border Height="1"
                        Background="{StaticResource StrokeBrush}"
                        Margin="0,0,0,22" />

                <StackPanel Margin="0,0,0,22"
                            HorizontalAlignment="Stretch">
                    <TextBlock Text="Third-party components"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Left"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,12" />
                    <TextBlock Text="{Binding VirtualDriverCredit}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,6" />
                    <TextBlock Text="{Binding RuntimeCredit}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               HorizontalAlignment="Stretch" />
                </StackPanel>

                <TextBlock Text="{Binding Copyright}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           TextAlignment="Left"
                           HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
