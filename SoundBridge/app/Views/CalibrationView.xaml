<UserControl x:Class="SoundBridge.Gui.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24">
            <TextBlock Text="Calibration"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,24" />
            <TextBlock Text="{Binding Instructions}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="13"
                       MaxWidth="620"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,18" />

            <Grid MaxWidth="560"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Active Template:"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ActiveDeviceName}"
                           Foreground="{StaticResource SuccessBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Row="2"
                        Grid.Column="1"
                        Content="Play Test"
                        Width="118"
                        HorizontalAlignment="Left"
                        Command="{Binding PlayTestCommand}" />
            </Grid>

            <Border CornerRadius="10"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Active multi-output device"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding ActiveDeviceName}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Sample rate"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding ActiveDeviceSampleRate}"
                                   FontSize="14"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Master device"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding ActiveDeviceMaster}"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Device"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Volume"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Background="{StaticResource StrokeBrush}" />

                <ItemsControl Grid.Row="2"
                              Grid.ColumnSpan="2"
                              ItemsSource="{Binding ActiveOutputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center" />
                                <Grid Grid.Column="1"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0"
                                            Maximum="100"
                                            Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Volume, StringFormat={}{0}%}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Border Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Background="#1A808080" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,30,0,0">
                <Button Content="Update Routing"
                        Command="{Binding UpdateRoutingCommand}"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRoutingStarted}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{Binding RoutingToggleButtonText}"
                        Command="{Binding StartRoutingCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    MaxWidth="560"
                    CornerRadius="12"
                    Background="#26FFFFFF"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    Padding="12,9"
                    Margin="0,14,0,0">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
