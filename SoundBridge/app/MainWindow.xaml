<Window x:Class="SoundBridge.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SoundBridge"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{StaticResource DialogBrush}"
        StateChanged="Window_StateChanged"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="DialogRoot"
                Background="{StaticResource DialogBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar"
                      Grid.Row="0"
                      Background="#05FFFFFF"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="138" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <Border Width="18"
                                Height="18"
                                CornerRadius="5"
                                Background="{StaticResource AccentBrush}"
                                Margin="0,0,10,0">
                            <TextBlock Text="S"
                                       Foreground="#0D1218"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="SoundBridge"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="0,8,12,8"
                            Padding="10,0"
                            CornerRadius="9"
                            Background="#0BFFFFFF"
                            BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding SelectedNavigationItem.Title}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="&#xE921;"
                                Style="{StaticResource WindowChromeButtonStyle}"
                                Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="&#xE922;"
                                Style="{StaticResource WindowChromeButtonStyle}"
                                Click="MaximizeButton_Click" />
                        <Button Content="&#xE8BB;"
                                Style="{StaticResource WindowChromeButtonStyle}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource SidebarBrush}"
                            BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="0,1,1,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top">
                                <Grid Margin="8,10,10,8">
                                    <Button x:Name="SidebarToggleButton"
                                            Content="&#xE700;"
                                            Style="{StaticResource IconButtonStyle}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTip="Collapse navigation"
                                            Click="ToggleSidebarButton_Click" />
                                </Grid>
                            </StackPanel>

                            <Border DockPanel.Dock="Bottom"
                                    Margin="0,8,0,10"
                                    Padding="0,8,0,0"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <Border x:Name="AboutActiveRail"
                                            Width="3"
                                            Height="16"
                                            CornerRadius="2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AboutNavigationItem.IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Button DataContext="{Binding AboutNavigationItem}"
                                            Command="{Binding DataContext.SelectAboutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="{Binding Title}">
                                        <Border x:Name="AboutNavSurface"
                                                CornerRadius="6"
                                                Padding="6,8"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="AboutNavText"
                                                           Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarFooterButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,2,0,10">
                                     <Grid x:Name="DeviceActionHost"
                                           Margin="0,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Width="3"
                                                Height="16"
                                                CornerRadius="2"
                                                Grid.Row="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDevicesExpanded}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource StrokeBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DevicesNavigationItem.IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Border Grid.Row="1"
                                                Width="3"
                                                Height="16"
                                                CornerRadius="2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Border Margin="8,0,8,0"
                                                CornerRadius="8"
                                                Padding="0"
                                                ToolTip="{Binding DevicesNavigationItem.Title}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DevicesNavigationItem.IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Command="{Binding ToggleDevicesExpandedCommand}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="6,8"
                                                        HorizontalContentAlignment="Stretch"
                                                        ToolTip="Expand or collapse devices">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DevicesNavigationItem.IconGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DevicesNavigationItem.Title}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   Margin="12,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>

                                                <Button x:Name="DeviceAddButton"
                                                        Grid.Column="1"
                                                        Content="&#xE710;"
                                                        Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        Command="{Binding CreateMultiOutputDeviceCommand}"
                                                        ToolTip="New multi-output device">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                            <Setter Property="Margin" Value="0,0,4,0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                            </Grid>
                                        </Border>

                                        <Button x:Name="DeviceAddCollapsedButton"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Content="&#xE710;"
                                                Width="36"
                                                Height="34"
                                                Padding="6"
                                                Margin="8,3,0,8"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                FontFamily="Segoe MDL2 Assets"
                                                HorizontalAlignment="Left"
                                                Command="{Binding ToggleDeviceCreateMenuCommand}"
                                                ToolTip="Create device">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding CreatedDeviceItems}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDevicesExpanded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Border x:Name="NestedActiveRail"
                                                            Width="3"
                                                            Height="14"
                                                            CornerRadius="2"
                                                            Background="Transparent"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center" />

                                                    <Button Command="{Binding DataContext.SelectNavigationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding Title}">
                                                        <Border x:Name="NestedNavSurface"
                                                                CornerRadius="8"
                                                                Padding="34,6,10,6"
                                                                Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBlock x:Name="NestedNavIcon"
                                                                           Text="{Binding IconGlyph}"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock x:Name="NestedNavText"
                                                                           Grid.Column="1"
                                                                           Text="{Binding Title}"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="8,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <TextBlock x:Name="NestedNavSubInfo"
                                                                           Grid.Row="1"
                                                                           Grid.Column="1"
                                                                           Text="{Binding SubInfo}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           Opacity="0.8"
                                                                           Margin="8,2,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarFooterButtonStyle}">
                                                                <Setter Property="Margin" Value="8,1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="NestedActiveRail" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="NestedNavSurface" Property="Background" Value="{StaticResource ActiveBrush}" />
                                                        <Setter TargetName="NestedNavIcon" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActiveDevice}" Value="True">
                                                        <Setter TargetName="NestedNavIcon" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        <Setter TargetName="NestedNavText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        <Setter TargetName="NestedNavSubInfo" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter TargetName="NestedNavSurface" Property="Padding" Value="6,8" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid>
                                        <Border x:Name="CalibrationActiveRail"
                                                Width="3"
                                                Height="16"
                                                CornerRadius="2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CalibrationNavigationItem.IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Button DataContext="{Binding CalibrationNavigationItem}"
                                                Command="{Binding DataContext.SelectNavigationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsEnabled}"
                                                ToolTip="{Binding Title}">
                                            <Border CornerRadius="8"
                                                    Padding="6,8"
                                                    Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}"
                                                               Grid.Column="1"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SidebarFooterButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <Grid>
                                        <Border x:Name="SettingsActiveRail"
                                                Width="3"
                                                Height="16"
                                                CornerRadius="2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SettingsNavigationItem.IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Button DataContext="{Binding SettingsNavigationItem}"
                                                Command="{Binding DataContext.SelectNavigationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Title}">
                                            <Border CornerRadius="8"
                                                    Padding="6,8"
                                                    Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}"
                                                               Grid.Column="1"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SidebarFooterButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="0,1,0,0"
                            ClipToBounds="True">
                        <ContentControl Content="{Binding SelectedPage}"
                                        ClipToBounds="True" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
</Window>
